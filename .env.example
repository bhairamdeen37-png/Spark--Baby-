# Copy this to .env for local dev (never commit the real .env).
# On Render, set these directly in the dashboard's Environment tab instead.

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs who can use owner/admin commands
BOT_OWNER_IDS=

# ── AI providers (at least one required; Gemini -> Groq -> OpenRouter order) ──
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides — check each provider's current docs before
# relying on these (model IDs get deprecated without much warning):
#   Gemini     -> https://ai.google.dev/gemini-api/docs/models
#   Groq       -> https://console.groq.com/docs/models
#   OpenRouter -> https://openrouter.ai/models
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free

# ── Storage (Turso — primary, real persistence across restarts/redeploys) ──
# From: turso db show <name> --url   and   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local fallback ONLY if TURSO_DATABASE_URL is empty — fine for local dev,
# but ephemeral on Render (wiped every redeploy). Don't rely on this in prod.
# DATABASE_PATH=spark_baby.db

# ── Memory / limits (sensible defaults already set in config.py) ──
# MAX_MEMORY_MESSAGES=15
# FREE_TEXT_DAILY_LIMIT=50
# FREE_IMAGE_DAILY_LIMIT=10
# LIMIT_WINDOW_HOURS=18

# LOG_LEVEL=INFO
